{
  "name": "black-vault-express-server",
  "version": "0.1.0",
  "description": "Servidor de Black Vault: API REST de gestión documental con Express y MongoDB (GridFS).",
  "private": true,
  "type": "module",
  "main": "src/servidor.js",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/servidor.js",
    "start": "node --env-file-if-exists=.env src/servidor.js",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 \"pruebas/**/*.test.js\""
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "mongodb": "^7.7.0",
    "morgan": "^1.12.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
