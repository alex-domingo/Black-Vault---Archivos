# Copia este archivo como .env y ajusta los valores.
# El archivo .env nunca se sube al repositorio. Este ejemplo NO debe llevar datos reales.

NODE_ENV=development
PUERTO=8000

# Usa 127.0.0.1 en lugar de localhost (en Windows evita que Node intente conectarse por IPv6).
# Sin autenticación:  mongodb://127.0.0.1:27017/black_vault
# Con autenticación:  mongodb://USUARIO:CLAVE@127.0.0.1:27017/black_vault?authSource=admin
#   (símbolos en la clave van codificados: @ → %40, : → %3A, / → %2F, # → %23, % → %25)
# Con replica set:    agrega &replicaSet=rs0 (o ?replicaSet=rs0)
URI_MONGODB=mongodb://127.0.0.1:27017/black_vault

# Orígenes permitidos por CORS (separados por comas).
ORIGEN_CLIENTE=http://localhost:4200

ZONA_HORARIA=America/Guatemala
TAMANO_MAXIMO_MB=5
CUOTA_POR_DEFECTO_MB=100

# Clave para firmar las sesiones (JWT): una cadena aleatoria de al menos 32 caracteres.
# Para generar una:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRETO=CAMBIA_ESTO_POR_UNA_CADENA_ALEATORIA_DE_32_O_MAS_CARACTERES
JWT_EXPIRACION=8h
